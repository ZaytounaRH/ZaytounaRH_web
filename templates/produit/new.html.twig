{% extends 'base.html.twig' %}

{% block title %}Créer un Nouveau Produit{% endblock %}

{% block body %}
    <h1>Créer un nouveau Produit</h1>

    {{ form_start(form) }}
        {{ form_row(form.produitName) }}
        {{ form_row(form.prix) }}
        {{ form_row(form.fournisseur) }}

        <button class="btn btn-success">Créer</button>
    {{ form_end(form) }}

    <a href="{{ path('app_produit_index') }}">Retour à la liste</a>
{% endblock %}
