{% extends 'base.html.twig' %}

{% block title %}Créer un Nouveau Fournisseur{% endblock %}

{% block body %}
    <h1>Créer un nouveau Fournisseur</h1>

    {{ form_start(form) }}
        {{ form_row(form.nomFournisseur) }}
        {{ form_row(form.adresse) }}
        {{ form_row(form.contact) }}
        {{ form_row(form.typeService) }}

        <button class="btn btn-success">Créer</button>
    {{ form_end(form) }}

    <a href="{{ path('app_fournisseur_index') }}">Retour à la liste</a>
{% endblock %}
