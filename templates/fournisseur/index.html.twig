{% extends 'base.html.twig' %}

{% block title %}Liste des Fournisseurs{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Gestion des Fournisseurs</h1>
    
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <i class="fas fa-table me-1"></i>
                Liste des Fournisseurs
            </div>
            <a href="{{ path('app_fournisseur_new') }}" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Ajouter un Fournisseur
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="datatablesSimple">
                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>Nom</th>
                            <th>Adresse</th>
                            <th>Contact</th>
                            <th>Type Service</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for fournisseur in fournisseurs %}
                        <tr>
                            <td>{{ fournisseur.id }}</td>
                            <td>{{ fournisseur.nomFournisseur }}</td>
                            <td>{{ fournisseur.adresse|default('N/A') }}</td>
                            <td>{{ fournisseur.contact|default('N/A') }}</td>
                            <td>
                                <span class="badge bg-{{ 
                                    fournisseur.typeService == 'TRANSPORT' ? 'primary' :
                                    fournisseur.typeService == 'BANK' ? 'success' :
                                    fournisseur.typeService == 'ELECTRONIQUE' ? 'info' :
                                    fournisseur.typeService == 'NOURRITURE' ? 'warning' :
                                    fournisseur.typeService == 'INFORMATIQUE' ? 'danger' : 'secondary'
                                }}">
                                    {{ fournisseur.typeService|default('Non spécifié') }}
                                </span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a href="{{ path('app_fournisseur_show', {'id': fournisseur.id}) }}" 
                                       class="btn btn-sm btn-info" title="Voir détails">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('app_fournisseur_edit', {'id': fournisseur.id}) }}" 
                                       class="btn btn-sm btn-warning" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_fournisseur_delete', {'id': fournisseur.id}) }}" 
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce fournisseur?');"
                                          class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ fournisseur.id) }}">
                                        <button class="btn btn-sm btn-danger" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center">Aucun fournisseur enregistré</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Active le plugin DataTables pour la pagination/tri
        document.addEventListener('DOMContentLoaded', function() {
            $('#datatablesSimple').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/fr-FR.json'
                },
                columnDefs: [
                    { orderable: false, targets: 5 } // Désactive le tri sur la colonne Actions
                ]
            });
        });
    </script>
{% endblock %}