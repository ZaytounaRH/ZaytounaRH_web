{% extends 'base.html.twig' %}

{% block title %}Détails du Fournisseur - {{ fournisseur.nomFournisseur }}{% endblock %}

{% block body %}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">
            <i class="fas fa-info-circle"></i> Détails du Fournisseur
        </h1>
        <div class="btn-group">
            <a href="{{ path('app_fournisseur_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la liste
            </a>
            <a href="{{ path('app_fournisseur_edit', {'id': fournisseur.id}) }}" class="btn btn-warning">
                <i class="fas fa-edit"></i> Modifier
            </a>
            {{ include('fournisseur/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-building"></i> Informations générales
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">ID:</dt>
                        <dd class="col-sm-8">{{ fournisseur.id }}</dd>

                        <dt class="col-sm-4">Nom:</dt>
                        <dd class="col-sm-8">{{ fournisseur.nomFournisseur }}</dd>

                        <dt class="col-sm-4">Type de service:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-{{ 
                                fournisseur.typeService == 'TRANSPORT' ? 'primary' :
                                fournisseur.typeService == 'BANK' ? 'success' :
                                fournisseur.typeService == 'ELECTRONIQUE' ? 'info' :
                                fournisseur.typeService == 'NOURRITURE' ? 'warning' :
                                fournisseur.typeService == 'INFORMATIQUE' ? 'danger' : 'secondary'
                            }}">
                                {{ fournisseur.typeService|default('Non spécifié') }}
                            </span>
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Contact:</dt>
                        <dd class="col-sm-8">{{ fournisseur.contact|default('Non renseigné') }}</dd>

                        <dt class="col-sm-4">Adresse:</dt>
                        <dd class="col-sm-8">{{ fournisseur.adresse|default('Non renseignée')|nl2br }}</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    {# Section pour afficher les produits associés si nécessaire #}
    {% if fournisseur.produits|length > 0 %}
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <i class="fas fa-boxes"></i> Produits fournis ({{ fournisseur.produits|length }})
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Nom Fournisseur</th>
                            <th>Prix</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for produit in fournisseur.produits %}
                        <tr>
                            <td>{{ produit.produitName }}</td>
                            <td>{{ produit.fournisseur.nomFournisseur }}</td>
                            <td>{{ produit.prix }} €</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}
    
</div>
{% endblock %}