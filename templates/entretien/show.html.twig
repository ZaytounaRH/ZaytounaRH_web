{% extends 'base.html.twig' %}

{% block title %}Détails de l'entretien{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4 text-center">Détails de l'entretien</h1>

        <div class="card shadow-lg">
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <tbody>
                        <tr>
                            <th scope="row" class="fw-bold">ID Entretien</th>
                            <td>{{ entretien.idEntretien }}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="fw-bold">Date de l'entretien</th>
                            <td>{{ entretien.dateEntretien ? entretien.dateEntretien|date('Y-m-d') : 'Non spécifiée' }}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="fw-bold">Heure de l'entretien</th>
                            <td>{{ entretien.heureEntretien ? entretien.heureEntretien|date('H:i:s') : 'Non spécifiée' }}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="fw-bold">Type d'entretien</th>
                            <td>{{ entretien.typeEntretien }}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="fw-bold">Statut</th>
                            <td>
                                <span class="badge bg-info">{{ entretien.statut }}</span>
                            </td>
                        </tr>
                        <tr>
                            <th scope="row" class="fw-bold">Commentaire</th>
                            <td>{{ entretien.commentaire ?: 'Aucun commentaire' }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_entretien_index') }}" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left-circle"></i> Retour à la liste
                    </a>

                    <a href="{{ path('app_entretien_edit', {'idEntretien': entretien.idEntretien}) }}" class="btn btn-warning">
                        <i class="bi bi-pencil-fill"></i> Modifier
                    </a>

                    <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="bi bi-trash-fill"></i> Supprimer
                    </button>
                </div>
            </div>
        </div>

        {# Modal de confirmation de suppression #}
        <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel">Confirmer la suppression</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Êtes-vous sûr de vouloir supprimer cet entretien ? Cette action est irréversible.
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        {{ form_start(delete_form) }}
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        {{ form_end(delete_form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
