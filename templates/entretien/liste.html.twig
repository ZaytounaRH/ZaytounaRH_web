{% extends 'base.html.twig' %}

{% block title %}Liste des Candidats{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="text-center mb-4">Liste des Candidats</h1>

        <!-- Liste des candidats -->
        <ul class="list-group">
            {% for candidat in candidats %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <a href="{{ path('app_candidat_mes_entretiens', {'candidatId': candidat.id}) }}" class="text-decoration-none text-dark">
                            <h5 class="mb-0">{{ candidat.getUser.nom }} {{ candidat.getUser.prenom }}</h5>
                        </a>
                    </div>
                </li>
            {% else %}
                <li class="list-group-item text-center text-muted">Aucun candidat trouvé.</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
