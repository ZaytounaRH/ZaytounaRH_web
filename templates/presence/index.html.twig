{% extends 'base.html.twig' %}

{% block title %}Presence index{% endblock %}

{% block body %}
    <h1>Presence index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id_presence</th>
                <th>Date</th>
                <th>HeureArrive</th>
                <th>HeureDepart</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for presence in presences %}
            <tr>
                <td>{{ presence.idPresence }}</td>
                <td>{{ presence.date ? presence.date|date('Y-m-d') : '' }}</td>
                <td>{{ presence.heureArrive ? presence.heureArrive|date('H:i:s') : '' }}</td>
                <td>{{ presence.heureDepart ? presence.heureDepart|date('H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_presence_show', {'id_presence': presence.id_presence}) }}">show</a>
                    <a href="{{ path('app_presence_edit', {'id_presence': presence.id_presence}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_presence_new') }}">Create new</a>
{% endblock %}
