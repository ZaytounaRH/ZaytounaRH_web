{% extends 'base.html.twig' %}

{% block title %}Budget{% endblock %}

{% block body %}
    <h1>Budget</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ budget.id }}</td>
            </tr>
            <tr>
                <th>MontantAlloue</th>
                <td>{{ budget.montantAlloue }}</td>
            </tr>
            <tr>
                <th>DateDebut</th>
                <td>{{ budget.dateDebut ? budget.dateDebut|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>DateFin</th>
                <td>{{ budget.dateFin ? budget.dateFin|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>TypeBudget</th>
                <td>{{ budget.typeBudget }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_budget_index') }}">back to list</a>

    <a href="{{ path('app_budget_edit', {'id': budget.id}) }}">edit</a>

    {{ include('budget/_delete_form.html.twig') }}
{% endblock %}
