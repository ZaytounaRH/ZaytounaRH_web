{% extends 'base.html.twig' %}

{% block title %}Offreemploi index{% endblock %}

{% block body %}
    <h1>Offreemploi index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>IdOffre</th>
                <th>TitreOffre</th>
                <th>Description</th>
                <th>DatePublication</th>
                <th>Salaire</th>
                <th>Statut</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for offreemploi in offreemplois %}
            <tr>
                <td>{{ offreemploi.idOffre }}</td>
                <td>{{ offreemploi.titreOffre }}</td>
                <td>{{ offreemploi.description }}</td>
                <td>{{ offreemploi.datePublication ? offreemploi.datePublication|date('Y-m-d') : '' }}</td>
                <td>{{ offreemploi.salaire }}</td>
                <td>{{ offreemploi.statut }}</td>
                <td>
                    <a href="{{ path('app_offreemploi_show', {'idOffre': offreemploi.idOffre}) }}">show</a>
                    <a href="{{ path('app_offreemploi_edit', {'idOffre': offreemploi.idOffre}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_offreemploi_new') }}">Create new</a>
{% endblock %}
