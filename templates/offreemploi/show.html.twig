{% extends 'base.html.twig' %}

{% block title %}Offreemploi{% endblock %}

{% block body %}
    <h1>Offreemploi</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>IdOffre</th>
                <td>{{ offreemploi.idOffre }}</td>
            </tr>
            <tr>
                <th>TitreOffre</th>
                <td>{{ offreemploi.titreOffre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ offreemploi.description }}</td>
            </tr>
            <tr>
                <th>DatePublication</th>
                <td>{{ offreemploi.datePublication ? offreemploi.datePublication|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Salaire</th>
                <td>{{ offreemploi.salaire }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ offreemploi.statut }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_offreemploi_index') }}">back to list</a>

    <a href="{{ path('app_offreemploi_edit', {'idOffre': offreemploi.idOffre}) }}">edit</a>

    {{ include('offreemploi/_delete_form.html.twig') }}
{% endblock %}
