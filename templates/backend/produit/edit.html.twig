{% extends 'admin/gestionfournisseur.html.twig' %}

{% block title %}Modifier Produit{% endblock %}

{% block body %}
    <h1>Modifier Produit</h1>

    {{ form_start(form) }}
        {{ form_row(form.produitName) }}
        {{ form_row(form.prix) }}
        {{ form_row(form.fournisseur) }}

        <button class="btn btn-primary">Mettre à jour</button>
    {{ form_end(form) }}

    <a href="{{ path('back_produit_index') }}" class="btn btn-secondary mt-2">Retour à la liste</a>

    {{ include('produit/_delete_form.html.twig') }}
{% endblock %}
