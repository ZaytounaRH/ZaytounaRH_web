{% extends 'base.html.twig' %}

{% block title %}Reclamation index{% endblock %}

{% block body %}
    <h1>Reclamation index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>IdR</th>
                <th>Titre</th>
                <th>Description</th>
                <th>IncidentType</th>
                <th>DateSoumission</th>
                <th>Statut</th>
                <th>Priorite</th>
                <th>PieceJointe</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reclamation in reclamations %}
            <tr>
                <td>{{ reclamation.idR }}</td>
                <td>{{ reclamation.titre }}</td>
                <td>{{ reclamation.description }}</td>
                <td>{{ reclamation.incidentType }}</td>
                <td>{{ reclamation.dateSoumission ? reclamation.dateSoumission|date('Y-m-d') : '' }}</td>
                <td>{{ reclamation.statut }}</td>
                <td>{{ reclamation.priorite }}</td>
                <td>{{ reclamation.pieceJointe }}</td>
                <td>
                    <a href="{{ path('app_reclamation_show', {'idR': reclamation.idR}) }}">show</a>
                    <a href="{{ path('app_reclamation_edit', {'idR': reclamation.idR}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_reclamation_new') }}">Create new</a>
{% endblock %}
