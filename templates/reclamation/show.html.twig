{% extends 'base.html.twig' %}

{% block title %}Reclamation{% endblock %}

{% block body %}
    <h1>Reclamation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>IdR</th>
                <td>{{ reclamation.idR }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ reclamation.titre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ reclamation.description }}</td>
            </tr>
            <tr>
                <th>IncidentType</th>
                <td>{{ reclamation.incidentType }}</td>
            </tr>
            <tr>
                <th>DateSoumission</th>
                <td>{{ reclamation.dateSoumission ? reclamation.dateSoumission|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ reclamation.statut }}</td>
            </tr>
            <tr>
                <th>Priorite</th>
                <td>{{ reclamation.priorite }}</td>
            </tr>
            <tr>
                <th>PieceJointe</th>
                <td>{{ reclamation.pieceJointe }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_reclamation_index') }}">back to list</a>

    <a href="{{ path('app_reclamation_edit', {'idR': reclamation.idR}) }}">edit</a>

    {{ include('reclamation/_delete_form.html.twig') }}
{% endblock %}
