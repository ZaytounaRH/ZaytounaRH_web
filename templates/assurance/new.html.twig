{% extends 'base.html.twig' %}

{% block title %}Créer une nouvelle assurance{% endblock %}

{% block body %}
<h1>Create new Assurance</h1>
<section id="new-assurance" class="section py-5">
  <div class="container" data-aos="fade-up">
    <div class="section-title">
      <h2>Nouvelle Assurance</h2>
      <p>Remplissez le formulaire pour ajouter une nouvelle assurance</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card p-4 shadow-sm">
          {{ include('assurance/_form.html.twig') }}
          <div class="mt-3">
            <a href="{{ path('app_assurance_index') }}" class="btn btn-secondary">
              <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
